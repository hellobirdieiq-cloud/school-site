": [{"t": "C", "w": ["dentist"]}, {"t": "C", "w": ["teeth"]}, {"t": "C", "w": ["day"]}]}, {"n": 89, "text": "The fans cheered loudly at Yankee Stadium.", "nouns": [{"t": "C", "w": ["fans"]}, {"t": "P", "w": ["yankee", "stadium"]}]}, {"n": 90, "text": "The pilot announced that the plane would land soon.", "nouns": [{"t": "C", "w": ["pilot"]}, {"t": "C", "w": ["plane"]}]}, {"n": 91, "text": "Mrs. Garcia planted roses along the fence.", "nouns": [{"t": "C", "w": ["roses"]}, {"t": "C", "w": ["fence"]}, {"t": "P", "w": ["mrs", "garcia"]}]}, {"n": 92, "text": "Happiness spread through the crowd when the concert began.", "nouns": [{"t": "C", "w": ["happiness"]}, {"t": "C", "w": ["crowd"]}, {"t": "C", "w": ["concert"]}]}, {"n": 93, "text": "The zookeeper fed the elephants at the San Diego Zoo.", "nouns": [{"t": "C", "w": ["zookeeper"]}, {"t": "C", "w": ["elephants"]}, {"t": "P", "w": ["san", "diego", "zoo"]}]}, {"n": 94, "text": "A tiny hummingbird hovered near the flowers.", "nouns": [{"t": "C", "w": ["hummingbird"]}, {"t": "C", "w": ["flowers"]}]}, {"n": 95, "text": "Jackie Robinson broke barriers in Major League Baseball.", "nouns": [{"t": "C", "w": ["barriers"]}, {"t": "P", "w": ["jackie", "robinson"]}, {"t": "P", "w": ["major", "league", "baseball"]}]}, {"n": 96, "text": "The students wrote poems about winter.", "nouns": [{"t": "C", "w": ["students"]}, {"t": "C", "w": ["poems"]}, {"t": "C", "w": ["winter"]}]}, {"n": 97, "text": "Our family drove across Nevada to reach Las Vegas.", "nouns": [{"t": "C", "w": ["family"]}, {"t": "P", "w": ["nevada"]}, {"t": "P", "w": ["las", "vegas"]}]}, {"n": 98, "text": "The carpenter measured the wood before cutting it.", "nouns": [{"t": "C", "w": ["carpenter"]}, {"t": "C", "w": ["wood"]}]}, {"n": 99, "text": "Ramadan is a special month for many families.", "nouns": [{"t": "C", "w": ["month"]}, {"t": "C", "w": ["families"]}, {"t": "P", "w": ["ramadan"]}]}, {"n": 100, "text": "The detective solved the mystery before midnight.", "nouns": 